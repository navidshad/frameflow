{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    // "Bundler", not "Node": main and preload are processed by electron-vite,
    // and the node10 algorithm cannot read the `exports` maps that the current
    // build toolchain (@vitejs/plugin-vue 6, vite 7) ships its types behind.
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts", "electron.vite.config.ts"]
}

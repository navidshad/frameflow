{
  "name": "frameflow",
  "version": "1.1.24",
  "type": "module",
  "description": "AI video editor for desktop. Edit by chat on a real timeline: cut filler, sync multicam, add motion graphics, captions and thumbnails.",
  "keywords": ["ai-video-editor", "video-editor", "video-editing", "text-based-editing", "multicam", "motion-graphics", "captions", "transcription", "thumbnail-generator", "ffmpeg", "electron", "vue", "mcp", "claude-code", "gemini-api"],
  "homepage": "https://github.com/navidshad/frameflow",
  "repository": { "type": "git", "url": "https://github.com/navidshad/frameflow.git" },
  "main": "./out/main/index.js",
  "author": "Navid Shad",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "node scripts/typecheck-web.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "start": "electron-vite preview",
    "start:debug": "electron-vite build && electron out/main/index.js --remote-debugging-port=9222",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node scripts/fetch-ffmpeg.mjs && node scripts/fetch-models.mjs && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "verify:ffmpeg": "node scripts/fetch-ffmpeg.mjs --verify-only",
    "verify:models": "node scripts/fetch-models.mjs --verify-only"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.113",
    "@ai-sdk/mcp": "2.0.92",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@google/genai": "^1.40.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^10.9.0",
    "ai": "7.0.164",
    "fluent-ffmpeg": "^2.1.3",
    "markdown-it": "^14.1.1",
    "onnxruntime-node": "1.31.1",
    "pilotui": "^1.29.1",
    "pinia": "^3.0.4",
    "uuid": "^13.0.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "ytdlp-nodejs": "^3.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@iconify-json/tabler": "^1.2.33",
    "@iconify/tailwind": "^1.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.19",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
